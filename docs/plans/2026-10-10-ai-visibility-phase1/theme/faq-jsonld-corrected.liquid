      }
    },
    {
      "@type": "Question",
      "name": "Where can I buy PROMUNCH snacks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can buy PROMUNCH snacks on our website promunch.in and on Amazon India."
      }
    },
    {
      "@type": "Question",
      "name": "Who founded PROMUNCH?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PROMUNCH was founded in 2021 by Parth Mutha and is based in Dewas, Madhya Pradesh, India. In 2025 Parth was named on the Forbes 30 Under 30 Asia list."
