<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@600;700;800&family=Assistant:wght@400;600;700&family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;700&family=Poppins:wght@500;600;700;800&family=Work+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Manrope:wght@400;600;700&family=Jost:wght@500;600;700&family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@600;700;800&family=Anton&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
 {{ 'custompro.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'custompro.js' | asset_url }}" defer="defer"></script>
  <script src="https://sdk.breezesdk.store/configs/a1e4f4-2/crt.js" async></script>
<script src="https://sdk.breezesdk.store/nexus/ctrl/shopify/mods/184.0.1/mod.js" async></script>
