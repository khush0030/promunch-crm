    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-11233764286');
    </script>

    <img
      alt="icon"
      id="svgicon"
      width="1400"
      height="1400"
