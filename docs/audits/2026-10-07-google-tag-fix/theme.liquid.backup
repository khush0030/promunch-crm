    <script>
      window.addEventListener('load', function() {
        document.addEventListener('click', function(e) {
          if (e.target.closest('.product-form__submit') || e.target.closest('.quick-add__submit')) {
            gtag('event', 'conversion', {
              'send_to': 'AW-11233764286/Ldx6CJC3pdMYEL7H1uwp'
            });
          }
          if (e.target.closest('.cart__checkout-button') || e.target.closest('[name="checkout"]')) {
            gtag('event', 'conversion', {
              'send_to': 'AW-11233764286/p495CJO3pdMYEL7H1uwp'
            });
          }
        });
        if (window.location.pathname == '/') {
          gtag('event', 'conversion', {
            'send_to': 'AW-11233764286/XrOOCJa3pdMYEL7H1uwp'
          });
        }
      })
      

      document.addEventListener("DOMContentLoaded", function () {

  if (window.innerWidth > 749) return;

  const headings = document.querySelectorAll(".footer-block__heading.inline-richtext");

  headings.forEach(function (heading) {

    const content = heading.parentElement.querySelector(".footer-block__details-content");

    if (!content) return;

    content.classList.remove("active");

    heading.addEventListener("click", function () {

      const isOpen = content.classList.contains("active");

      // Close all
      document.querySelectorAll(".footer-block__details-content").forEach(function (item) {
        item.classList.remove("active");
      });

      document.querySelectorAll(".footer-block__heading.inline-richtext").forEach(function (item) {
        item.classList.remove("active");
      });

      // Open clicked
      if (!isOpen) {
        content.classList.add("active");
        heading.classList.add("active");
      }

    });

  });

});
    </script>
