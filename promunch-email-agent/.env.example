# PROMUNCH Email Agent — environment variables
# Copy to .env and fill in real values, then run:
#   supabase secrets set --env-file .env

# -- Mailbox the agent watches ---------------------------------------------
MAILBOX_EMAIL=hello@promunch.in

# -- Google Cloud / Gmail OAuth --------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Type: Web application. Add redirect URI = your OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/oauth-callback

# Random string. Used as the ?token= query param to gate /oauth-callback.
# Generate with: openssl rand -hex 24
SETUP_TOKEN=

# -- Gmail Pub/Sub (optional but recommended for instant push) -------------
# Full topic name like: projects/<gcp-project>/topics/<topic-name>
# Grant the gmail-api-push@system.gserviceaccount.com service account
# the Pub/Sub Publisher role on this topic before calling watch().
GMAIL_PUBSUB_TOPIC=

# Random string echoed in the webhook URL as ?token=… so only Pub/Sub can hit
# /gmail-webhook. Add to the Pub/Sub push subscription URL.
PUBSUB_VERIFICATION_TOKEN=

# -- Slack ------------------------------------------------------------------
# Create app at https://api.slack.com/apps (use slack-app-manifest.json)
# Bot scopes needed: chat:write, channels:history, groups:history,
#   im:history, mpim:history (optional), reactions:write, files:write
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_ID=                     # the U… id of your bot user (find via auth.test)
SLACK_CHANNEL_ID=C...                  # destination channel for new emails

# -- OpenAI -----------------------------------------------------------------
# Powers email drafting (_shared/openai.ts), classification (_shared/classify.ts),
# the WhatsApp AI agent (wa-ai-reply), and campaign personalization
# (wa-campaign-send). gpt-4o-mini is roughly 1/20th the cost of Claude Sonnet
# for this workload; bump OPENAI_MODEL to "gpt-4o" if drafting quality drops.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini               # default drafting model
# Optional per-function overrides — leave unset to use OPENAI_MODEL.
# OPENAI_CLASSIFY_MODEL=gpt-4o-mini
# WA_PERSONALIZE_MODEL=gpt-4o-mini

# -- WhatsApp (Meta Cloud API) ---------------------------------------------
# Get these from https://developers.facebook.com — WhatsApp > API Setup
# Webhook callback URL to enter in Meta:
#   https://<SUPABASE_PROJECT_REF>.supabase.co/functions/v1/wa-webhook
WHATSAPP_PHONE_NUMBER_ID=                  # numeric Phone Number ID (sender)
WHATSAPP_ACCESS_TOKEN=                     # permanent System User access token
WHATSAPP_VERIFY_TOKEN=                     # random string, used in Meta webhook UI
WHATSAPP_APP_SECRET=                       # app secret, used for X-Hub-Signature-256
WHATSAPP_GRAPH_VERSION=v21.0
WA_AI_MODEL=gpt-4o-mini                    # which OpenAI model the WA agent uses

# -- KB storage bucket ------------------------------------------------------
# Create a Supabase Storage bucket of this name (private) before uploading PDFs.
KB_BUCKET=kb-docs

# -- Nitro (NitroCommerce) webhook -----------------------------------------
# Webhook URL to paste in Nitro dashboard > Connect with Webhook > Endpoint:
#   https://<SUPABASE_PROJECT_REF>.supabase.co/functions/v1/nitro-webhook
# NITRO_ORG_TOKEN: the UUID Nitro assigns your store (appears as body.org_token).
# NITRO_AUTH_TOKEN: random secret you generate and paste into Nitro's
#   "Authorization Token" field. We verify it on the Authorization header.
#   Generate with: openssl rand -hex 32
NITRO_ORG_TOKEN=
NITRO_AUTH_TOKEN=
